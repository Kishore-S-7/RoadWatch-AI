# ==============================================================================
# RoadWatch AI - Backend Environment Example
# ==============================================================================

PROJECT_NAME="RoadWatch AI"
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# MongoDB Configuration (Local or Cloud / Atlas)
# ------------------------------------------------------------------------------
# For MongoDB Cloud (Atlas):
# MONGODB_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
# For Local MongoDB:
# MONGODB_URL="mongodb://localhost:27017"

MONGODB_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="roadwatch"

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
SECRET_KEY="roadwatch-secret-key-change-this-in-production-environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# AI Defect Vision Engine (YOLOv8 & OpenCV)
# ------------------------------------------------------------------------------
YOLO_WEIGHTS_PATH="weights/best.pt"
YOLO_CONFIDENCE_THRESHOLD=0.25
UPLOAD_DIR="uploads"

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"


