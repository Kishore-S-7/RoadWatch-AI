# ==============================================================================
# RoadWatch AI - Git Ignore
# ==============================================================================

# Environment files & Secrets (never commit credentials)
.env
.env.local
.env.*.local
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
env/
ENV/
.venv/

# Node & Frontend Dependencies & Builds
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/

# Uploaded Files & Temporary Media (preserve directories with .gitkeep)
backend/uploads/originals/*
!backend/uploads/originals/.gitkeep
backend/uploads/annotated/*
!backend/uploads/annotated/.gitkeep
backend/uploads/project_images/*
!backend/uploads/project_images/.gitkeep
backend/uploads/complaints/*
!backend/uploads/complaints/.gitkeep

# Large AI Model Weights (downloaded or loaded on demand)
*.pt
*.onnx
backend/weights/*.pt
!backend/weights/.gitkeep

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
